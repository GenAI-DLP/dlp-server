# 로컬 설정 오버라이드.
# 우선순위: 환경변수 > .env > app/config.yaml > 코드 기본값
# 중첩 필드는 이중 밑줄(__): DLP_DB__DSN -> db.dsn, DLP_GRPC__PORT -> grpc.port

# DLP_DB__DSN=postgresql://dlp:dlp@localhost:5432/dlp
# DLP_LOG_SINK=pg          # pg | jsonl | both
# DLP_LOG_PATH=./log_events.jsonl
# DLP_FAIL_ACTION=block
# DLP_GRPC__PORT=50051

# 볼트 cipher_value AES-GCM 키 — base64(32 bytes).
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# DLP_VAULT__KEY=
